import Fastify from 'fastify'
import pg from 'pg'

const db = new pg.Pool({ host: '127.0.0.1', database: 'lifeos', user: process.env.USER })
const app = Fastify({ logger: true, bodyLimit: 10 * 1024 * 1024 })

// проверка, что сервер и база живы
app.get('/health', async () => {
  const { rows } = await db.query('SELECT now()')
  return { ok: true, time: rows[0].now }
})

// сюда Overland будет слать точки пачками
app.post('/overland', async (req) => {
   console.log('OVERLAND:', JSON.stringify(req.body).slice(0, 1000))
  const locs = req.body?.locations ?? []
  for (const f of locs) {
    const [lon, lat] = f.geometry.coordinates   // внимание: сначала lon, потом lat
    const p = f.properties
    await db.query(
      'INSERT INTO locations (ts, lat, lon, accuracy, speed) VALUES ($1, $2, $3, $4, $5)',
      [p.timestamp, lat, lon, p.horizontal_accuracy ?? null, p.speed ?? null]
    )
  }
  return { result: 'ok' }   // Overland ждёт именно такой ответ
})

await app.listen({ host: '0.0.0.0', port: 3000 })
